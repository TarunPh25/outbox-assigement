PORT=4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me

DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth (console.cloud.google.com -> Credentials -> OAuth client, type Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Slack OAuth (api.slack.com/apps -> scope "incoming-webhook"; redirect must be HTTPS, e.g. ngrok)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://YOUR-NGROK-URL/api/slack/callback

# Scheduler tuning
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
SENDER_COUNT=3

# Optional: add Ethereal accounts manually if the auto-create call fails on your network
# Create at https://ethereal.email/create  ->  ETHEREAL_ACCOUNTS=user1@ethereal.email:pass1,user2@ethereal.email:pass2
ETHEREAL_ACCOUNTS=
# Use 465 if port 587 is blocked on your network (try: Test-NetConnection smtp.ethereal.email -Port 465)
ETHEREAL_SMTP_PORT=587
# Local dev fallback (Mailpit in docker-compose) when Ethereal is blocked:
#   ETHEREAL_SMTP_HOST=localhost
#   ETHEREAL_SMTP_PORT=1025
#   ETHEREAL_ACCOUNTS=sender1@local.test:x,sender2@local.test:x
#   SENDER_COUNT=2
